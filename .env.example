DATABASE_URL=postgres://user:password@localhost:5432/ai_blog
DB_HOST=localhost
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=ai_blog
NODE_ENV=development
APP_URL=http://localhost:3000

# Request protection. Defaults are production-safe; only enable proxy trust when
# the API is behind a known reverse proxy which removes untrusted forwarded headers.
TRUST_PROXY=false
AUTH_LOGIN_ACCOUNT_IP_LIMIT=5
AUTH_LOGIN_IP_LIMIT=20
AUTH_LOGIN_WINDOW_SECONDS=900
PUBLIC_ANALYTICS_IP_LIMIT=120
PUBLIC_ANALYTICS_WINDOW_SECONDS=60
PUBLIC_ANALYTICS_DEDUPE_SECONDS=1800

# AI Provider Configuration
AI_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3

# Online Provider (Optional)
ONLINE_AI_BASE_URL=
ONLINE_AI_API_KEY=
ONLINE_AI_MODEL=

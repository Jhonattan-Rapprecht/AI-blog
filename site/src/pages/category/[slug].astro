---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import Pagination from '../../components/Pagination.astro';
import { listArticles, listCategories } from '../../lib/api.js';

const { slug } = Astro.params;
const page = Math.max(1, parseInt(Astro.url.searchParams.get('page') || '1', 10) || 1);

const categories = await listCategories();
const category = categories?.find((c) => c.slug === slug);
if (!category) return Astro.rewrite('/404');

const result = await listArticles({ page, category: slug });
---

<BaseLayout title={category.name} description={category.description || `Articles about ${category.name}.`}>
  <div class="mx-auto grid max-w-5xl gap-8 px-6 py-12">
    <div>
      <a href="/blog" class="text-sm text-muted-foreground hover:text-foreground">← All articles</a>
      <h1 class="mt-6 text-3xl font-semibold tracking-tight">{category.name}</h1>
      {category.description && <p class="mt-2 text-muted-foreground">{category.description}</p>}
      <p class="mt-1 text-sm text-muted-foreground">{result.total} {result.total === 1 ? 'article' : 'articles'}</p>
    </div>

    {result.articles.length === 0 && <p class="rounded-md border p-6 text-sm text-muted-foreground">No articles in this category yet.</p>}

    <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {result.articles.map((a) => <ArticleCard article={a} />)}
    </div>

    <Pagination page={page} pages={result.pages} base={`/category/${slug}`} />
  </div>
</BaseLayout>

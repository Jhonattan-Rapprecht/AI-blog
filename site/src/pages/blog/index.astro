---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import Pagination from '../../components/Pagination.astro';
import { listArticles, listCategories } from '../../lib/api.js';

const page = Math.max(1, parseInt(Astro.url.searchParams.get('page') || '1', 10) || 1);
const q = (Astro.url.searchParams.get('q') || '').trim();
const category = (Astro.url.searchParams.get('category') || '').trim();

let result = { articles: [], total: 0, pages: 1 };
let categories = [];
let failed = false;
try {
  [result, categories] = await Promise.all([listArticles({ page, q, category }), listCategories()]);
} catch (e) {
  console.error(e);
  failed = true;
}
const topics = categories.filter((c) => c.article_count > 0);
const selectedCategory = topics.find((c) => c.slug === category);
const filterQuery = new URLSearchParams();
if (category) filterQuery.set('category', category);
if (q) filterQuery.set('q', q);
---

<BaseLayout title={selectedCategory?.name || 'Blog'} description={selectedCategory?.description || 'Fresh perspectives on AI, technology, business, and the ideas shaping what comes next.'} categories={topics}>
  <div class="blog-page">
    <section class="blog-intro" aria-labelledby="blog-title">
      <div>
        <p class="eyebrow">The AI Blogstudio journal</p>
        <h1 id="blog-title" class="blog-title">{selectedCategory?.name || 'Ideas shaping what’s next.'}</h1>
        <p class="blog-description">{selectedCategory?.description || 'Explore thoughtful perspectives on artificial intelligence, technology, business, and the people navigating change.'}</p>
      </div>
      <form id="blog-search" method="get" action="/blog" role="search" class="site-search blog-intro__search">
        {category && <input type="hidden" name="category" value={category} />}
        <label class="sr-only" for="blog-search-query">Search articles</label>
        <input id="blog-search-query" name="q" type="search" value={q} placeholder="Search articles and ideas..." class="site-search__input" />
        <button class="site-search__button" type="submit" aria-label="Search articles"><svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><circle cx="11" cy="11" r="7"/><path d="m20 20-4-4"/></svg></button>
      </form>
    </section>

    <section class="blog-filter-row" aria-label="Article topics">
      <span class="blog-filter-label">Explore topics</span>
      <div id="blog-filters" aria-label="Filter articles by category">
        <a href={`/blog${q ? `?q=${encodeURIComponent(q)}` : ''}`} data-category="" aria-current={!category ? 'page' : undefined} class="category-filter">All topics</a>
        {topics.map((c) => <a href={`/blog?category=${encodeURIComponent(c.slug)}${q ? `&q=${encodeURIComponent(q)}` : ''}`} data-category={c.slug} aria-current={category === c.slug ? 'page' : undefined} class="category-filter">{c.name}</a>)}
        <span id="blog-count">{result.total} {result.total === 1 ? 'story' : 'stories'}{selectedCategory ? ` in ${selectedCategory.name}` : ''}</span>
      </div>
    </section>

    <section aria-label="Article feed">
      <div class="blog-feed-toolbar">
        <span class="blog-feed-toolbar__label"><span id="blog-feed-label">{q ? `Search results for “${q}”` : selectedCategory ? `Stories in ${selectedCategory.name}` : 'Latest stories'}</span> <span aria-hidden="true">·</span> <span id="blog-feed-total">{result.total} {result.total === 1 ? 'article' : 'articles'}</span></span>
        <div class="blog-controls">
          <div class="blog-control-group" role="group" aria-label="Article card layout">
            <button type="button" class="blog-control" data-layout-choice="grid" aria-pressed="true"><svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect width="7" height="7" x="3" y="3" rx="1"/><rect width="7" height="7" x="14" y="3" rx="1"/><rect width="7" height="7" x="14" y="14" rx="1"/><rect width="7" height="7" x="3" y="14" rx="1"/></svg>Grid</button>
            <button type="button" class="blog-control" data-layout-choice="list" aria-pressed="false"><svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M9 6h12M9 12h12M9 18h12M4 6h.01M4 12h.01M4 18h.01"/></svg>List</button>
          </div>
          <div class="blog-control-group" role="group" aria-label="Article loading mode">
            <button type="button" class="blog-control" data-load-mode="pages" aria-pressed="true">Pages</button>
            <button type="button" class="blog-control" data-load-mode="infinite" aria-pressed="false">Infinite scroll</button>
          </div>
        </div>
      </div>

      <p id="blog-loading" class="sr-only" role="status" aria-live="polite"></p>
      <p id="blog-empty" hidden={!failed && result.articles.length > 0}>{failed ? 'The blog is temporarily unavailable.' : 'No articles match your search yet. Try another phrase or topic.'}</p>
      <div id="blog-articles" data-layout="grid" data-page={result.page} data-pages={result.pages} class="grid" aria-busy="false">
        {result.articles.map((a, index) => <ArticleCard article={a} featured={index === 0} />)}
      </div>
      <div id="blog-infinite-status" aria-live="polite" hidden></div>
      <div id="blog-pagination"><Pagination page={page} pages={result.pages} base="/blog" query={filterQuery.toString()} /></div>
    </section>
  </div>
</BaseLayout>

<script>
  import { listArticles, formatDate, imageUrl } from '../../lib/api.js';

  const grid = document.querySelector('#blog-articles');
  const count = document.querySelector('#blog-count');
  const feedLabel = document.querySelector('#blog-feed-label');
  const feedTotal = document.querySelector('#blog-feed-total');
  const empty = document.querySelector('#blog-empty');
  const loading = document.querySelector('#blog-loading');
  const pagination = document.querySelector('#blog-pagination');
  const filters = document.querySelector('#blog-filters');
  const searchForm = document.querySelector('#blog-search');
  const infiniteStatus = document.querySelector('#blog-infinite-status');
  const layoutButtons = [...document.querySelectorAll('[data-layout-choice]')];
  const loadModeButtons = [...document.querySelectorAll('[data-load-mode]')];
  let requestId = 0;
  let appendRequestId = 0;
  let loadingNextPage = false;
  let appendFailed = false;
  let nextPage = Number(grid.dataset.page || 1) + 1;
  let totalPages = Number(grid.dataset.pages || 1);
  let layout = localStorage.getItem('blog-card-layout') === 'list' ? 'list' : 'grid';
  let loadMode = localStorage.getItem('blog-load-mode') === 'infinite' ? 'infinite' : 'pages';
  let observer;

  const currentParams = () => new URLSearchParams(window.location.search);

  function setButtonState(buttons, attribute, selected) {
    for (const button of buttons) {
      const active = button.dataset[attribute] === selected;
      button.setAttribute('aria-pressed', String(active));
      button.classList.toggle('bg-primary', active);
      button.classList.toggle('text-primary-foreground', active);
    }
  }

  function observeInfiniteSentinel() {
    observer?.disconnect();
    infiniteStatus.hidden = loadMode !== 'infinite';
    pagination.hidden = loadMode === 'infinite';
    if (loadMode !== 'infinite') return;
    if (nextPage > totalPages) {
      infiniteStatus.textContent = `${count.textContent.split(' ')[0]} articles shown`;
      return;
    }
    if (loadingNextPage || appendFailed || !('IntersectionObserver' in window)) return;
    observer = new IntersectionObserver((entries) => {
      if (entries.some((entry) => entry.isIntersecting)) loadNextPage();
    }, { rootMargin: '320px' });
    observer.observe(infiniteStatus);
  }

  function applyDisplayPreferences() {
    grid.dataset.layout = layout;
    setButtonState(layoutButtons, 'layoutChoice', layout);
    setButtonState(loadModeButtons, 'loadMode', loadMode);
    observeInfiniteSentinel();
  }

  function updateCount(result, query, category) {
    const categoryName = category ? filters?.querySelector(`[data-category="${CSS.escape(category)}"]`)?.textContent || 'this category' : '';
    count.textContent = `${result.total} ${result.total === 1 ? 'article' : 'articles'}${query ? ` matching “${query}”` : ''}${category ? ` in ${categoryName}` : ''}`;
    feedLabel.textContent = query ? `Search results for “${query}”${category ? ` in ${categoryName}` : ''}` : category ? `Stories in ${categoryName}` : 'Latest stories';
    feedTotal.textContent = `${result.total} ${result.total === 1 ? 'article' : 'articles'}`;
  }

  function setFilterState(category) {
    for (const link of filters?.querySelectorAll('.category-filter') || []) {
      const active = link.dataset.category === category;
      link.classList.toggle('bg-primary', active);
      link.classList.toggle('text-primary-foreground', active);
      link.setAttribute('aria-current', active ? 'page' : 'false');
    }
  }

  function showLoading() {
    grid.setAttribute('aria-busy', 'true');
    loading.textContent = 'Loading articles';
    empty.hidden = true;
    grid.replaceChildren(...Array.from({ length: 6 }, () => {
      const card = document.createElement('div');
      card.className = 'overflow-hidden rounded-lg border animate-pulse';
      const image = document.createElement('div');
      image.className = 'aspect-[16/9] bg-muted';
      const body = document.createElement('div');
      body.className = 'grid gap-3 p-5';
      const badge = document.createElement('div');
      badge.className = 'h-5 w-20 rounded-full bg-muted';
      const title = document.createElement('div');
      title.className = 'h-5 w-4/5 rounded bg-muted';
      const excerpt = document.createElement('div');
      excerpt.className = 'h-4 w-full rounded bg-muted';
      body.append(badge, title, excerpt);
      card.append(image, body);
      return card;
    }));
  }

  function articleCard(article, featured = false) {
    const link = document.createElement('a');
    link.href = `/blog/${encodeURIComponent(article.slug)}`;
    link.className = `story-card${featured ? ' story-card--lead' : ''}`;

    const media = document.createElement('span');
    media.className = 'story-card__media';
    media.setAttribute('aria-hidden', 'true');
    if (article.featured_image) {
      const image = document.createElement('img');
      image.src = imageUrl(article.featured_image);
      image.alt = '';
      image.loading = featured ? 'eager' : 'lazy';
      if (featured) image.fetchPriority = 'high';
      image.className = 'story-card__image';
      media.append(image);
    } else {
      const placeholder = document.createElement('div');
      placeholder.className = 'story-card__image--missing';
      placeholder.textContent = 'AI';
      media.append(placeholder);
    }
    link.append(media);

    const body = document.createElement('span');
    body.className = 'story-card__body';
    const meta = document.createElement('span');
    meta.className = 'story-card__meta';
    const badge = document.createElement('span');
    badge.className = 'story-card__category';
    badge.textContent = article.category_name || 'Uncategorized';
    meta.append(badge);
    if (article.published_at) {
      const date = document.createElement('time');
      date.dateTime = article.published_at;
      date.textContent = formatDate(article.published_at);
      meta.append(date);
    }
    const title = document.createElement('span');
    title.className = 'story-card__title';
    title.textContent = article.title;
    body.append(meta, title);
    if (article.excerpt) {
      const excerpt = document.createElement('span');
      excerpt.className = 'story-card__excerpt';
      excerpt.textContent = article.excerpt;
      body.append(excerpt);
    }
    const footer = document.createElement('span');
    footer.className = 'story-card__footer';
    const readLabel = document.createElement('span');
    readLabel.textContent = 'Read story';
    const arrow = document.createElement('span');
    arrow.className = 'story-card__arrow';
    arrow.setAttribute('aria-hidden', 'true');
    arrow.textContent = '→';
    footer.append(readLabel, arrow);
    body.append(footer);
    link.append(body);
    return link;
  }

  function renderPagination(page, pages, params) {
    pagination.replaceChildren();
    if (pages <= 1) return;
    const nav = document.createElement('nav');
    nav.className = 'flex items-center justify-between border-t pt-6 text-sm';
    nav.setAttribute('aria-label', 'Pagination');
    const makeLink = (target, label) => {
      const next = new URLSearchParams(params);
      if (target > 1) next.set('page', String(target));
      else next.delete('page');
      const link = document.createElement('a');
      link.href = `/blog${next.size ? `?${next}` : ''}`;
      link.dataset.page = String(target);
      link.className = 'rounded-md border px-3 py-1.5 hover:bg-accent';
      link.textContent = label;
      return link;
    };
    nav.append(page > 1 ? makeLink(page - 1, '← Newer') : document.createElement('span'));
    const label = document.createElement('span');
    label.className = 'text-muted-foreground';
    label.textContent = `Page ${page} of ${pages}`;
    nav.append(label);
    nav.append(page < pages ? makeLink(page + 1, 'Older →') : document.createElement('span'));
    pagination.append(nav);
  }

  async function loadArticles(params, { updateUrl = true } = {}) {
    const id = ++requestId;
    appendRequestId += 1;
    loadingNextPage = false;
    appendFailed = false;
    const category = params.get('category') || '';
    const query = params.get('q') || '';
    const page = Number(params.get('page')) || 1;
    setFilterState(category);
    showLoading();
    if (updateUrl) history.pushState({}, '', `/blog${params.size ? `?${params}` : ''}`);

    try {
      const result = await listArticles({ category, q: query, page });
      if (id !== requestId) return;
      grid.replaceChildren(...result.articles.map((article, index) => articleCard(article, index === 0)));
      grid.setAttribute('aria-busy', 'false');
      grid.dataset.page = String(result.page);
      grid.dataset.pages = String(result.pages);
      nextPage = result.page + 1;
      totalPages = result.pages;
      loading.textContent = '';
      empty.hidden = result.articles.length > 0;
      empty.textContent = result.articles.length ? '' : 'No articles found.';
      updateCount(result, query, category);
      renderPagination(result.page, result.pages, params);
      applyDisplayPreferences();
    } catch (error) {
      if (id !== requestId) return;
      console.error(error);
      grid.replaceChildren();
      grid.setAttribute('aria-busy', 'false');
      loading.textContent = '';
      empty.textContent = 'The blog is temporarily unavailable.';
      empty.hidden = false;
    }
  }

  async function loadNextPage() {
    if (loadingNextPage || appendFailed || nextPage > totalPages || loadMode !== 'infinite') return;
    loadingNextPage = true;
    const operationId = ++appendRequestId;
    const activeRequestId = requestId;
    const params = currentParams();
    const category = params.get('category') || '';
    const query = params.get('q') || '';
    infiniteStatus.hidden = false;
    infiniteStatus.innerHTML = '<span class="size-4 animate-spin rounded-full border-2 border-current border-r-transparent"></span><span>Loading more articles…</span>';
    grid.setAttribute('aria-busy', 'true');
    try {
      const result = await listArticles({ category, q: query, page: nextPage });
      if (activeRequestId !== requestId || operationId !== appendRequestId) return;
      grid.append(...result.articles.map(articleCard));
      nextPage = result.page + 1;
      totalPages = result.pages;
      grid.dataset.page = String(result.page);
      grid.dataset.pages = String(result.pages);
      updateCount(result, query, category);
      infiniteStatus.textContent = nextPage > totalPages
        ? `${result.total} ${result.total === 1 ? 'article' : 'articles'} shown`
        : 'Scroll to load more articles';
    } catch (error) {
      if (activeRequestId !== requestId || operationId !== appendRequestId) return;
      console.error(error);
      appendFailed = true;
      infiniteStatus.replaceChildren();
      const message = document.createElement('span');
      message.textContent = 'Could not load more articles.';
      const retry = document.createElement('button');
      retry.type = 'button';
      retry.className = 'rounded-md border px-3 py-1 text-xs hover:bg-accent';
      retry.textContent = 'Retry';
      retry.addEventListener('click', () => { appendFailed = false; loadNextPage() }, { once: true });
      infiniteStatus.append(message, retry);
    } finally {
      if (activeRequestId === requestId && operationId === appendRequestId) {
        loadingNextPage = false;
        grid.setAttribute('aria-busy', 'false');
        if (!appendFailed) observeInfiniteSentinel();
      }
    }
  }

  layoutButtons.forEach((button) => button.addEventListener('click', () => {
    layout = button.dataset.layoutChoice;
    localStorage.setItem('blog-card-layout', layout);
    applyDisplayPreferences();
  }));

  loadModeButtons.forEach((button) => button.addEventListener('click', () => {
    loadMode = button.dataset.loadMode;
    localStorage.setItem('blog-load-mode', loadMode);
    const params = currentParams();
    params.delete('page');
    loadArticles(params);
  }));

  filters?.addEventListener('click', (event) => {
    const link = event.target.closest('.category-filter');
    if (!link) return;
    event.preventDefault();
    const params = currentParams();
    params.delete('page');
    if (link.dataset.category) params.set('category', link.dataset.category);
    else params.delete('category');
    loadArticles(params);
  });

  pagination?.addEventListener('click', (event) => {
    const link = event.target.closest('a[data-page]');
    if (!link) return;
    event.preventDefault();
    const params = new URL(link.href).searchParams;
    loadArticles(params);
  });

  searchForm?.addEventListener('submit', (event) => {
    event.preventDefault();
    const params = currentParams();
    params.delete('page');
    const query = new FormData(searchForm).get('q')?.toString().trim();
    if (query) params.set('q', query);
    else params.delete('q');
    loadArticles(params);
  });

  window.addEventListener('popstate', () => loadArticles(currentParams(), { updateUrl: false }));
  applyDisplayPreferences();
</script>

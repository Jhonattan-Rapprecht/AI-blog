---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ClassicEditorial from '../../components/article/ClassicEditorial.astro';
import MagazineSplit from '../../components/article/MagazineSplit.astro';
import ImmersiveFeature from '../../components/article/ImmersiveFeature.astro';
import { getArticle, listCategories, readingTime, imageUrl } from '../../lib/api.js';

const [articleResult, categoriesResult] = await Promise.allSettled([getArticle(Astro.params.slug), listCategories()]);
const article = articleResult.status === 'fulfilled' ? articleResult.value : null;
const categories = categoriesResult.status === 'fulfilled' ? categoriesResult.value : [];
if (!article) return Astro.rewrite('/404');
const toc = [];
const usedIds = new Set();
const plainHeadingText = (html) => html.replace(/<[^>]*>/g, ' ').replace(/&nbsp;|&#160;|&#xA0;/gi, ' ').replace(/&amp;/gi, '&').replace(/&lt;/gi, '<').replace(/&gt;/gi, '>').replace(/&quot;/gi, '"').replace(/&#39;|&apos;/gi, "'").replace(/\s+/g, ' ').trim();
const slugify = (value) => value.normalize('NFKD').replace(/[\u0300-\u036f]/g, '').toLowerCase().replace(/[^\p{L}\p{N}]+/gu, '-').replace(/^-|-$/g, '');
const escapeAttribute = (value) => value.replace(/&/g, '&amp;').replace(/"/g, '&quot;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
const articleHtml = String(article.content || '').replace(/<h([23])\b([^>]*)>([\s\S]*?)<\/h\1>/gi, (match, level, attributes, inner) => {
  const text = plainHeadingText(inner); if (!text) return match;
  const oldId = attributes.match(/\bid\s*=\s*(["'])(.*?)\1/i)?.[2]; const base = oldId || slugify(text) || `section-${toc.length + 1}`;
  let id = base; let suffix = 2; while (usedIds.has(id)) id = `${base}-${suffix++}`; usedIds.add(id); toc.push({ id, text, level: Number(level) });
  const newAttributes = /\bid\s*=\s*(["']).*?\1/i.test(attributes) ? attributes.replace(/\bid\s*=\s*(["']).*?\1/i, `id="${escapeAttribute(id)}"`) : `${attributes} id="${escapeAttribute(id)}"`;
  return `<h${level}${newAttributes}>${inner}</h${level}>`;
});
const readMinutes = readingTime(article.content);
const articleUrl = new URL(`/blog/${encodeURIComponent(article.slug)}`, Astro.site).href;
const encodedUrl = encodeURIComponent(articleUrl);
const encodedTitle = encodeURIComponent(article.title);
const layout = ['split', 'immersive'].includes(article.design?.layout) ? article.design.layout : 'classic';
const stylePreset = article.design?.styleSource && article.design.styleSource !== 'fallback' ? article.design.stylePreset : null;
---
<BaseLayout title={article.seo_title || article.title} description={article.seo_description || article.excerpt || undefined} image={imageUrl(article.featured_image) || undefined} type="article" categories={categories}>
  <div class:list={['article-style', stylePreset && `article-style--${stylePreset}`]}>
    {layout === 'split' ? <MagazineSplit article={article} toc={toc} articleHtml={articleHtml} readMinutes={readMinutes} /> : layout === 'immersive' ? <ImmersiveFeature article={article} toc={toc} articleHtml={articleHtml} readMinutes={readMinutes} /> : <ClassicEditorial article={article} toc={toc} articleHtml={articleHtml} readMinutes={readMinutes} encodedUrl={encodedUrl} encodedTitle={encodedTitle} />}
  </div>
</BaseLayout>
<script>
  import { trackArticleRead } from '../../lib/analytics.js';
  const articleElement = document.querySelector('[data-article-read-id]'); if (articleElement) trackArticleRead(articleElement.dataset.articleReadId);
  const progress = document.querySelector('.article-progress'); const progressBar = document.querySelector('#article-progress-bar'); const body = document.querySelector('#article-body'); let scheduled = false;
  const updateProgress = () => { if (!progress || !progressBar || !body) return; const bounds = body.getBoundingClientRect(); const start = window.scrollY + bounds.top; const scrollable = Math.max(1, body.offsetHeight - window.innerHeight * .35); const value = Math.min(100, Math.max(0, ((window.scrollY - start + 90) / scrollable) * 100)); progressBar.style.width = `${value}%`; progress.setAttribute('aria-valuenow', String(Math.round(value))); scheduled = false; };
  const scheduleProgress = () => { if (scheduled) return; scheduled = true; window.requestAnimationFrame(updateProgress); }; window.addEventListener('scroll', scheduleProgress, { passive: true }); window.addEventListener('resize', scheduleProgress); updateProgress();
  const copyButton = document.querySelector('#copy-article-link'); const shareStatus = document.querySelector('#share-status'); copyButton?.addEventListener('click', async () => { try { await navigator.clipboard.writeText(window.location.href); shareStatus.textContent = 'Link copied.'; } catch { shareStatus.textContent = 'Copying is unavailable in this browser. Select the page address to copy it.'; } });
  const tocLinks = [...document.querySelectorAll('[data-toc-id]')]; if ('IntersectionObserver' in window && tocLinks.length) { const headingObserver = new IntersectionObserver((entries) => { const visible = entries.filter((entry) => entry.isIntersecting).sort((a, b) => a.boundingClientRect.top - b.boundingClientRect.top)[0]; if (!visible) return; for (const link of tocLinks) { if (link.dataset.tocId === visible.target.id) link.setAttribute('aria-current', 'location'); else link.removeAttribute('aria-current'); } }, { rootMargin: '-12% 0px -72% 0px' }); for (const link of tocLinks) { const heading = document.getElementById(link.dataset.tocId); if (heading) headingObserver.observe(heading); } }
  document.querySelectorAll('.article-toc__mobile a').forEach((link) => link.addEventListener('click', () => { const details = link.closest('details'); if (details) details.open = false; }));
</script>

---
import { formatDate, imageUrl, readingTime } from '../lib/api.js';

const { article, featured = false } = Astro.props;
const estimatedReadingTime = article.content ? readingTime(article.content) : null;
---

<a href={`/blog/${encodeURIComponent(article.slug)}`} class:list={['story-card', featured && 'story-card--lead']}>
  <span class="story-card__media" aria-hidden="true">
    {article.featured_image
      ? <img src={imageUrl(article.featured_image)} alt="" loading={featured ? 'eager' : 'lazy'} fetchpriority={featured ? 'high' : undefined} class="story-card__image" />
      : <span class="story-card__image--missing"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="3"/><circle cx="8.5" cy="8.5" r="1.5"/><path d="m21 15-5-5L5 21"/></svg></span>}
  </span>
  <span class="story-card__body">
    <span class="story-card__meta">
      <span class="story-card__category">{article.category_name || 'Uncategorized'}</span>
      {article.published_at && <time datetime={article.published_at}>{formatDate(article.published_at)}</time>}
      {estimatedReadingTime && <span>{estimatedReadingTime} min read</span>}
    </span>
    <span class="story-card__title">{article.title}</span>
    {article.excerpt && <span class="story-card__excerpt">{article.excerpt}</span>}
    <span class="story-card__footer"><span>Read story</span><span class="story-card__arrow" aria-hidden="true">→</span></span>
  </span>
</a>

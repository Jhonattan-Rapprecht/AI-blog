---
const { id, query = '', className = '' } = Astro.props;
---

<form id={id} method="get" action="/blog" role="search" class={className}>
  <label class="sr-only" for={`${id}-query`}>Search articles</label>
  <input id={`${id}-query`} name="q" value={query} type="search" placeholder="Search stories" class="site-search__input" />
  <button class="site-search__button" type="submit" aria-label="Search articles">
    <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><circle cx="11" cy="11" r="7"/><path d="m20 20-4-4"/></svg>
  </button>
</form>

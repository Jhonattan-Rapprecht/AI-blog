---
import ArticleCard from '../ArticleCard.astro';
import { formatDate, imageUrl, normalizeHtml } from '../../lib/api.js';
const { article, toc, articleHtml, readMinutes, encodedUrl, encodedTitle } = Astro.props;
---
<div class="article-progress" role="progressbar" aria-label="Article reading progress" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0"><span class="article-progress__bar" id="article-progress-bar"></span></div>
<article data-article-read-id={article.id}>
  <header class="article-hero">
    {article.featured_image ? <img src={imageUrl(article.featured_image)} alt={article.title} fetchpriority="high" class="article-hero__image" /> : <div class="article-hero__fallback" aria-hidden="true" />}
    <div class="article-hero__inner"><div class="article-hero__content">
      <a href="/blog" class="article-back"><span aria-hidden="true">←</span> All stories</a>
      <div class="article-hero__meta">{article.category_name && <a href={article.category_slug ? `/category/${encodeURIComponent(article.category_slug)}` : '/blog'} class="article-hero__category">{article.category_name}</a>}{article.published_at && <time datetime={article.published_at}>{formatDate(article.published_at)}</time>}<span aria-hidden="true">·</span><span>{readMinutes} min read</span></div>
      <h1>{article.title}</h1>{article.excerpt && <p class="article-hero__excerpt">{article.excerpt}</p>}{article.featured_image && article.featured_image_credit && <p class="article-hero__credit">Photo credit/source: {article.featured_image_credit}</p>}
    </div></div>
  </header>
  <div class:list={['article-reading-layout', !toc.length && 'article-reading-layout--no-toc']}>
    {toc.length > 0 && <aside class="article-toc" aria-label="Article contents"><nav class="article-toc__desktop" aria-label="On this page"><p class="article-rail__title">On this page</p><div class="article-toc__links">{toc.map((heading) => <a href={`#${heading.id}`} data-toc-id={heading.id} data-level={heading.level}>{heading.text}</a>)}</div></nav><details class="article-toc__mobile"><summary>On this page <span aria-hidden="true">⌄</span></summary><nav class="article-toc__links" aria-label="Article contents">{toc.map((heading) => <a href={`#${heading.id}`} data-toc-id={heading.id} data-level={heading.level}>{heading.text}</a>)}</nav></details></aside>}
    <div class="article-body" id="article-body">{article.excerpt && <p class="article-body__intro">{article.excerpt}</p>}<div class="prose prose-article max-w-none" set:html={normalizeHtml(articleHtml)} /></div>
    <aside class="article-rail" aria-label="Article tools and recommendations">
      <section class="article-rail__panel" aria-labelledby="share-title"><h2 class="article-rail__title" id="share-title">Share this article</h2><div class="share-actions">
        <a class="share-action" href={`https://twitter.com/intent/tweet?url=${encodedUrl}&text=${encodedTitle}`} target="_blank" rel="noopener noreferrer" aria-label="Share on X" title="Share on X"><svg aria-hidden="true" viewBox="0 0 24 24" fill="currentColor"><path d="M18.9 2H22l-6.8 7.8L23.2 22h-6.3L12 14.6 5.5 22H2.4l7.3-8.4L1.9 2h6.5l4.5 6.8L18.9 2Zm-1.1 18h1.7L7.4 3.9H5.6L17.8 20Z"/></svg></a>
        <a class="share-action" href={`https://www.linkedin.com/sharing/share-offsite/?url=${encodedUrl}`} target="_blank" rel="noopener noreferrer" aria-label="Share on LinkedIn" title="Share on LinkedIn"><svg aria-hidden="true" viewBox="0 0 24 24" fill="currentColor"><path d="M20.45 20.45h-3.56v-5.57c0-1.33-.02-3.04-1.85-3.04-1.85 0-2.13 1.45-2.13 2.94v5.67H9.35V8.98h3.42v1.57h.05c.48-.9 1.64-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.46v6.29ZM5.34 7.43a2.06 2.06 0 1 1 0-4.12 2.06 2.06 0 0 1 0 4.12ZM7.12 20.45H3.56V8.98h3.56v11.47ZM22.22 0H1.77C.79 0 0 .77 0 1.73v20.54C0 23.23.79 24 1.77 24h20.45c.98 0 1.78-.77 1.78-1.73V1.73C24 .77 23.2 0 22.22 0Z"/></svg></a>
        <a class="share-action" href={`https://www.facebook.com/sharer/sharer.php?u=${encodedUrl}`} target="_blank" rel="noopener noreferrer" aria-label="Share on Facebook" title="Share on Facebook"><svg aria-hidden="true" viewBox="0 0 24 24" fill="currentColor"><path d="M24 12a12 12 0 1 0-13.88 11.86v-8.4H7.08V12h3.04V9.36c0-3 1.79-4.66 4.52-4.66 1.31 0 2.68.23 2.68.23v2.95h-1.51c-1.49 0-1.95.92-1.95 1.87V12h3.32l-.53 3.46h-2.79v8.4A12 12 0 0 0 24 12Z"/></svg></a>
        <button id="copy-article-link" class="share-action" type="button" aria-label="Copy article link" title="Copy article link"><svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M10 13a5 5 0 0 0 7.07 0l3-3A5 5 0 0 0 13 2.93l-1.72 1.71"/><path d="M14 11a5 5 0 0 0-7.07 0l-3 3A5 5 0 0 0 11 21.07l1.71-1.71"/></svg></button>
      </div><p id="share-status" class="share-status" role="status" aria-live="polite"></p></section>
      {article.related?.length > 0 && <section class="article-rail__panel article-rail__panel--related" aria-labelledby="related-rail-title"><h2 class="article-rail__title" id="related-rail-title">Keep reading</h2><div class="article-rail__related">{article.related.map((related) => <a class="related-story" href={`/blog/${encodeURIComponent(related.slug)}`}>{related.featured_image ? <img src={imageUrl(related.featured_image)} alt="" loading="lazy" /> : <span class="related-story__fallback" aria-hidden="true" />}<span><span class="related-story__title">{related.title}</span><span class="related-story__meta">{related.category_name || 'Uncategorized'}</span></span></a>)}</div></section>}
    </aside>
  </div>
</article>
{article.related?.length > 0 && <section class="article-related-bottom" aria-labelledby="related-title"><div class="article-related-bottom__inner"><p class="eyebrow">Continue exploring</p><h2 id="related-title">More ideas for you</h2><div class="article-related-grid">{article.related.map((related, index) => <ArticleCard article={related} featured={index === 0} />)}</div></div></section>}
